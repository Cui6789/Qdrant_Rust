# kb-server 可选配置示例 —— 复制为 .env 后按需修改，切勿提交真实密钥。
#
# 环境变量规则：前缀 KB_，嵌套层级用双下划线 __ 分隔，例如
#   server.port                -> KB_SERVER__PORT
#   embedding.api.api_key      -> KB_EMBEDDING__API__API_KEY
#
# 优先级：内置默认值 < config/config.toml < 环境变量 < 后台保存的覆盖项。
# Docker Compose 会自动读取本目录下的 .env 并插值到 docker-compose.yml。
# 本地运行时（未用 Docker）请在启动前导出变量，例如 PowerShell：
#   $env:KB_EMBEDDING__PROVIDER = "api"

# ---- HTTP server -----------------------------------------------------------
# KB_SERVER__HOST=0.0.0.0
# KB_SERVER__PORT=8080
# 非空时所有 /v1 请求必须携带 Authorization: Bearer <key>（/health 除外）。
# KB_SERVER__API_KEY=
# KB_SERVER__MAX_BODY_MB=32
# KB_SERVER__REQUEST_TIMEOUT_SECS=300

# 管理端 /admin/ 使用独立的 Bearer 密钥。用密码生成器创建随机值。
# KB_ADMIN__ACCESS_KEY=
# KB_ADMIN__SETTINGS_PATH=./data/settings/runtime.json

# ---- Qdrant ----------------------------------------------------------------
# 注意：docker-compose.yml 已固定容器内的 KB_QDRANT__URL=http://qdrant:6334
# 和 KB_EMBEDDING__LOCAL__CACHE_DIR=/data/models；下面两项的覆盖主要用于
# 非 Docker 的本地运行（会写入 .env，但 Compose 中对应值不会插值）。
# 必须是 gRPC 端口（默认 6334），不是 REST 端口 6333。
# KB_QDRANT__URL=http://localhost:6334
# KB_QDRANT__API_KEY=
# KB_QDRANT__TIMEOUT_SECS=30
# KB_QDRANT__STARTUP_RETRY_SECS=30

# ---- Embedding -------------------------------------------------------------
# local = fastembed/ONNX；api = 远程 API；mock = 确定性演示（非语义模型）。
# KB_EMBEDDING__PROVIDER=local
# KB_EMBEDDING__BATCH_SIZE=32
# KB_EMBEDDING__MAX_CONCURRENT_BATCHES=4
# KB_EMBEDDING__MOCK_DIMENSIONS=512

# 本地模型（仅 provider=local 时生效；Docker Compose 固定缓存目录为 /data/models）。
# KB_EMBEDDING__LOCAL__MODEL=bge-small-zh-v1.5
# KB_EMBEDDING__LOCAL__DIMENSIONS=0  # 0 使用模型原始维度；自定义值不能超过原始维度
# KB_EMBEDDING__LOCAL__CACHE_DIR=./data/models
# KB_EMBEDDING__LOCAL__SHOW_DOWNLOAD_PROGRESS=true
# KB_EMBEDDING__LOCAL__MAX_LENGTH=512
# KB_EMBEDDING__LOCAL__WARMUP=true
# 留空表示使用模型默认前缀；填写则覆盖。
# KB_EMBEDDING__LOCAL__QUERY_PREFIX=
# KB_EMBEDDING__LOCAL__DOCUMENT_PREFIX=

# API embedding（仅 provider=api 时生效）。下面以 OpenAI 为例，
# 其它兼容端点（通义/SiliconFlow/Ollama/vLLM）见 README。
# KB_EMBEDDING__API__PROTOCOL=openai   # openai 或 dashscope
# KB_EMBEDDING__API__BASE_URL=https://api.openai.com/v1
# KB_EMBEDDING__API__API_KEY=sk-REPLACE_ME
# KB_EMBEDDING__API__MODEL=text-embedding-3-small
# 0 表示启动时用探针请求自动获取维度。
# KB_EMBEDDING__API__DIMENSIONS=0
# KB_EMBEDDING__API__TIMEOUT_SECS=60
# KB_EMBEDDING__API__MAX_RETRIES=3

# ---- 本地模型下载 ----------------------------------------------------------
# 国内网络可使用镜像；也可设置 HF_HOME / HF_TOKEN。
# HF_ENDPOINT=https://hf-mirror.com
# HF_HOME=./data/hf

# ---- Rerank ---------------------------------------------------------------
# KB_RERANK__PROVIDER=disabled
# KB_RERANK__CANDIDATE_LIMIT=30
# KB_RERANK__LOCAL__MODEL=bge-reranker-v2-m3
# KB_RERANK__LOCAL__CACHE_DIR=./data/models
# KB_RERANK__API__ENDPOINT=https://api.siliconflow.com/v1/rerank
# KB_RERANK__API__MODEL=Qwen/Qwen3-Reranker-8B
# KB_RERANK__API__API_KEY=
# KB_RERANK__API__TIMEOUT_SECS=60

# ---- 文件解析 -------------------------------------------------------------
# KB_PARSING__PROVIDER=native
# 本地启动时设为实际端点。Compose 默认使用容器内的 MinerU 端点。
# KB_PARSING__MINERU__LOCAL_URL=http://127.0.0.1:8000/file_parse
# KB_PARSING__MINERU__CLOUD_URL=https://mineru.net/api/v4
# KB_PARSING__MINERU__MODEL_VERSION=vlm
# KB_PARSING__MINERU__API_KEY=
# KB_PARSING__MINERU__TIMEOUT_SECS=600

# ---- 可视化工作台（由 kb-server 托管）------------------------------------
# Compose 自动启用工作台，绑定宿主机回环；可覆盖宿主机端口。
# KB_DASHBOARD_HTTP_PORT=8090
# 非 Docker 启动时，设置 DASHBOARD_PORT 启用监听。工作台使用后台模型，没有登录鉴权。
# DASHBOARD_HOST=127.0.0.1
# DASHBOARD_PORT=8090
# DASHBOARD_UI_DIR=crates/kb-dashboard-ui/dist

# ---- 其它 ------------------------------------------------------------------
# 配置文件路径（也可用 --config <path> 覆盖）。
# KB_CONFIG=config/config.toml
# 集成测试使用的 Qdrant gRPC 地址（仅测试进程读取）。
# KB_TEST_QDRANT_URL=http://127.0.0.1:6334
