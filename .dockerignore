# Keep the Docker context to source, manifests and the server's embedded admin
# assets. Dockerfile itself is always sent to the builder.
*
!Cargo.toml
!Cargo.lock
!crates/
!crates/**
!config/
!config/config.example.toml

# Local outputs, caches and generated dashboard assets are never build inputs.
crates/**/target/
crates/**/dist/
crates/**/.fastembed_cache/
crates/**/.trunk/
crates/**/node_modules/
